    "## 4. Shared Training & Evaluation Utilities\n",
    "\n",
    "To ensure a fair comparison across all three candidate models, we use a consistent training protocol:\n",
    "- **Loss:** `sparse_categorical_crossentropy` (for integer labels `0–49`)\n",
    "- **Optimiser:** `Adam`\n",
    "- **Callbacks:** `EarlyStopping` monitoring `val_accuracy` (patience 6, `restore_best_weights=True`) and `ReduceLROnPlateau` monitoring `val_loss` (factor 0.5, patience 3)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "results = {}\n",
    "models = {}\n",
    "histories = {}\n",
    "\n",
    "def compile_model(model, lr=1e-3):\n",
    "    model.compile(\n",
    "        optimizer=keras.optimizers.Adam(learning_rate=lr),\n",
    "        loss='sparse_categorical_crossentropy',\n",
    "        metrics=['accuracy']\n",
    "    )\n",
    "    return model\n",
    "\n",
    "def train_model(model, name, epochs=30, batch_size=128):\n",
    "    callbacks = [\n",
    "        keras.callbacks.EarlyStopping(\n",
    "            monitor='val_accuracy', patience=6, restore_best_weights=True, verbose=1\n",
    "        ),\n",
    "        keras.callbacks.ReduceLROnPlateau(\n",
    "            monitor='val_loss', factor=0.5, patience=3, min_lr=1e-6, verbose=1\n",
    "        ),\n",
    "    ]\n",
    "    t0 = time.time()\n",
    "    hist = model.fit(\n",
    "        X_tr, y_tr,\n",
    "        validation_data=(X_val, y_val),\n",
    "        epochs=epochs, batch_size=batch_size,\n",
    "        callbacks=callbacks, verbose=2\n",
    "    )\n",
    "    elapsed = time.time() - t0\n",
    "    histories[name] = hist\n",
    "    models[name] = model\n",
    "    print(f\"{name}: trained {len(hist.history['loss'])} epochs in {elapsed/60:.1f} min\")\n",
    "    return hist, elapsed\n",
    "\n",
    "def plot_history(hist_obj, title):\n",
    "    h = hist_obj.history\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
    "    axes[0].plot(h['accuracy'], label='Train')\n",
    "    axes[0].plot(h['val_accuracy'], label='Validation')\n",
    "    axes[0].set_title(f'{title} — Accuracy')\n",
    "    axes[0].set_xlabel('Epoch')\n",
    "    axes[0].set_ylabel('Accuracy')\n",
    "    axes[0].legend(); axes[0].grid(alpha=0.3)\n",
    "\n",
    "    axes[1].plot(h['loss'], label='Train')\n",
    "    axes[1].plot(h['val_loss'], label='Validation')\n",
    "    axes[1].set_title(f'{title} — Loss')\n",
    "    axes[1].set_xlabel('Epoch')\n",
    "    axes[1].set_ylabel('Loss')\n",
    "    axes[1].legend(); axes[1].grid(alpha=0.3)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "def evaluate_on_validation(name, train_seconds=None):\n",
    "    model = models[name]\n",
    "    val_loss, val_acc = model.evaluate(X_val, y_val, verbose=0)\n",
    "    results[name] = {\n",
    "        'Val Loss': round(float(val_loss), 4),\n",
    "        'Val Accuracy (%)': round(float(val_acc) * 100, 2),\n",
    "        'Total Params': model.count_params(),\n",
    "        'Trainable Params': sum(int(tf.size(w)) for w in model.trainable_weights),\n",
    "        'Epochs Run': len(histories[name].history['loss']),\n",
    "        'Train Time (min)': round(train_seconds / 60, 1) if train_seconds else None,\n",
    "    }\n",
    "    print(f\"{name} -> Val Loss: {val_loss:.4f} | Val Accuracy: {val_acc*100:.2f}%\")\n",
    "    return val_loss, val_acc"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Candidate Model 1 — MobileNet Transfer Learning (Compulsory)\n",
    "\n",
    "### Model Description & Justification\n",
    "We employ **MobileNet** (`keras.applications.MobileNet`) pre-trained on ImageNet (`include_top=False`) as our frozen feature extractor. Because MobileNet expects larger spatial inputs while CIFAR-100 images are 32×32, we insert an internal `Resizing(128, 128)` layer (offering a practical balance between visual fidelity and GPU memory/speed, especially on 4–8 GB GPUs) followed by `Rescaling(1./127.5, offset=-1)` to match MobileNet's `[-1, 1]` input range. A lightweight classification head (`GlobalAveragePooling2D -> Dropout(0.3) -> Dense(50, softmax)`) is attached on top.\n",
    "\n",
    "**Strengths for this task:**\n",
    "- Reuses rich hierarchical visual representations learned from 1.4M ImageNet images, compensating for the limited ~400 training images per class.\n",
    "- Depthwise separable convolutions keep MobileNet computationally efficient.\n",
    "- After training the classifier head, an optional Stage 2 fine-tuning step unfreezes the top 20 layers with a low learning rate (`1e-5`) to adapt high-level features to CIFAR-100's low-resolution animal/people textures."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "MOBILENET_SIZE = 128  # 128x128 runs fast on Colab/RTX 3050 while preserving MobileNet receptive fields\n",
    "\n",
    "def build_model1():\n",
    "    base = keras.applications.MobileNet(\n",
    "        weights='imagenet', include_top=False, input_shape=(MOBILENET_SIZE, MOBILENET_SIZE, 3)\n",
    "    )\n",
    "    base.trainable = False\n",
    "\n",
    "    inputs = keras.Input(shape=(32, 32, 3))\n",
    "    x = layers.RandomFlip('horizontal')(inputs)\n",
    "    x = layers.Resizing(MOBILENET_SIZE, MOBILENET_SIZE)(x)\n",
    "    x = layers.Rescaling(1./127.5, offset=-1)(x)\n",
    "    x = base(x, training=False)\n",
    "    x = layers.GlobalAveragePooling2D()(x)\n",
    "    x = layers.Dropout(0.3)(x)\n",
    "    outputs = layers.Dense(NUM_CLASSES, activation='softmax')(x)\n",
    "    return compile_model(keras.Model(inputs, outputs, name='Model1_MobileNet_TL'), lr=1e-3), base\n",
    "\n",
    "model1, mobilenet_base = build_model1()\n",
    "model1.summary()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Stage 1: Train classification head with frozen backbone\n",
    "hist1, t1 = train_model(model1, 'Model1_MobileNet_TL', epochs=20, batch_size=64)\n",
    "\n",
    "# Stage 2: Fine-tune top 20 layers of MobileNet with a low learning rate\n",
    "mobilenet_base.trainable = True\n",
    "for layer in mobilenet_base.layers[:-20]:\n",
    "    layer.trainable = False\n",
    "compile_model(model1, lr=1e-5)\n",
    "\n",
    "t_ft = time.time()\n",
    "hist1_ft = model1.fit(\n",
    "    X_tr, y_tr, validation_data=(X_val, y_val),\n",
    "    epochs=10, batch_size=64, verbose=2,\n",
    "    callbacks=[keras.callbacks.EarlyStopping(monitor='val_accuracy', patience=4, restore_best_weights=True, verbose=1)]\n",
    ")\n",
    "t1 += (time.time() - t_ft)\n",
    "\n",
    "# Combine Stage 1 and Stage 2 histories for plotting\n",
    "for k in hist1.history:\n",
    "    if k in hist1_ft.history:\n",
    "        hist1.history[k] += hist1_ft.history[k]\n",
    "\n",
    "plot_history(hist1, 'Model 1: MobileNet Transfer Learning + Fine-Tuning')\n",
    "evaluate_on_validation('Model1_MobileNet_TL', t1)"
   ]
  },
  {
