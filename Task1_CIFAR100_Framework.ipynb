    "---\n",
    "# Task 1 — The Given Task: CIFAR-100 Subset (Animals & People)\n",
    "\n",
    "## 3. Dataset Loading & Stratified Split\n",
    "\n",
    "Using the 50 class indices specified in the project appendix, we filter the CIFAR-100 dataset to retain only animals and people, remapping the original fine labels to contiguous integers `0–49`. We split the 25,000 training images using a **stratified 80/20 split** (20,000 train / 5,000 validation, i.e., 400 train and 100 validation images per class). The 5,000 test images remain strictly untouched until the final evaluation of the recommended model."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "ANIMALS_PEOPLE_INDICES = [\n",
    "    1, 2, 3, 4, 6, 7, 11, 14, 15, 18, 19,\n",
    "    21, 24, 26, 27, 29, 30, 31, 32, 34, 35,\n",
    "    36, 38, 42, 43, 44, 45, 46, 50, 55, 57,\n",
    "    63, 64, 65, 66, 67, 72, 73, 74, 75, 77,\n",
    "    78, 79, 80, 91, 93, 95, 97, 98, 99\n",
    "]\n",
    "NUM_CLASSES = len(ANIMALS_PEOPLE_INDICES)  # 50\n",
    "\n",
    "def select_animals_people(y):\n",
    "    \"\"\"Returns a boolean mask for selecting animals/people in y.\"\"\"\n",
    "    return np.isin(np.ravel(y), ANIMALS_PEOPLE_INDICES)\n",
    "\n",
    "def compress_animals_people_indices(y):\n",
    "    \"\"\"Maps original CIFAR-100 indices to range 0..49.\"\"\"\n",
    "    lookup = np.zeros(100, dtype=np.int32)\n",
    "    for new_id, old_id in enumerate(ANIMALS_PEOPLE_INDICES):\n",
    "        lookup[old_id] = new_id\n",
    "    return lookup[np.ravel(y)].reshape(-1, 1)\n",
    "\n",
    "def load_cifar100_animals_people():\n",
    "    (X_train, y_train), (X_test, y_test) = cifar100.load_data(label_mode='fine')\n",
    "    m_tr = select_animals_people(y_train)\n",
    "    m_te = select_animals_people(y_test)\n",
    "    X_train, y_train = X_train[m_tr], y_train[m_tr]\n",
    "    X_test,  y_test  = X_test[m_te],  y_test[m_te]\n",
    "    y_train = compress_animals_people_indices(y_train)\n",
    "    y_test  = compress_animals_people_indices(y_test)\n",
    "    return X_train, y_train, X_test, y_test\n",
    "\n",
    "X_train, y_train, X_test, y_test = load_cifar100_animals_people()\n",
    "\n",
    "print(\"X_train:\", X_train.shape, \"y_train:\", y_train.shape)\n",
    "print(\"X_test: \", X_test.shape,  \"y_test: \", y_test.shape)\n",
    "print(\"Label range:\", y_train.min(), \"-\", y_train.max())\n",
    "print(\"Pixel range:\", X_train.min(), \"-\", X_train.max())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load human-readable fine label names from CIFAR-100 metadata\n",
    "meta_path = keras.utils.get_file(\n",
    "    'cifar-100-python.tar.gz',\n",
    "    'https://www.cs.toronto.edu/~kriz/cifar-100-python.tar.gz'\n",
    ")\n",
    "with tarfile.open(meta_path) as tar:\n",
    "    meta = pickle.load(tar.extractfile('cifar-100-python/meta'), encoding='bytes')\n",
    "fine_label_names = [n.decode('utf-8') for n in meta[b'fine_label_names']]\n",
    "class_names = [fine_label_names[i] for i in ANIMALS_PEOPLE_INDICES]\n",
    "print(f\"{NUM_CLASSES} classes:\", class_names)\n",
    "\n",
    "# Visualise 16 random training samples\n",
    "fig, axes = plt.subplots(2, 8, figsize=(14, 4))\n",
    "rng = np.random.default_rng(SEED)\n",
    "idx = rng.choice(len(X_train), size=16, replace=False)\n",
    "for ax, i in zip(axes.ravel(), idx):\n",
    "    ax.imshow(X_train[i])\n",
